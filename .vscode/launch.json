{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch weather-stats (--once)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/weather-stats",
            "args": ["--once"],
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Launch weather-stats (loop)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/weather-stats",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Debug tests in current package",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}"
        }
    ]
}
